# Opcional: endereço do site, sem barra no fim (canonical, sitemap, Open Graph e JSON-LD).
# Na Vercel não precisa: o site usa o domínio de produção do projeto (.vercel.app ou o domínio próprio).
NEXT_PUBLIC_SITE_URL=

# Opcional: ID do Google Analytics 4 (G-XXXXXXXXXX). Sem ele, nenhum script de analytics é carregado.
NEXT_PUBLIC_GA_ID=

# Opcional: código de verificação do Google Search Console (meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
